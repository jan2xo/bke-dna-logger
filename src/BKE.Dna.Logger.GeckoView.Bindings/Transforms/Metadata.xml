<metadata>
  <!--
    GeckoView is a large Android implementation artifact, while BKE DNA only
    needs its embedding surface (runtime/session/view/WebExtension). Keep the
    Java artifact intact and shape only the managed binding surface here.
  -->

  <!-- AIDL interfaces named I* produce managed helper names that collide with
       Mozilla's concrete implementation classes. Preserve both Java types by
       giving only the concrete implementations distinct managed names. -->
  <attr path="/api/package[@name='org.mozilla.gecko']/class[@name='GeckoEditableChild']"
        name="managedName">GeckoEditableChildImpl</attr>
  <attr path="/api/package[@name='org.mozilla.gecko.gfx']/class[@name='CompositorSurfaceManager']"
        name="managedName">CompositorSurfaceManagerImpl</attr>
  <attr path="/api/package[@name='org.mozilla.gecko.media']/class[@name='MediaManager']"
        name="managedName">MediaManagerImpl</attr>
  <attr path="/api/package[@name='org.mozilla.gecko.crashhelper']/class[@name='CrashHelper']"
        name="managedName">CrashHelperImpl</attr>

  <!-- GeckoSession.Window is package-private Java implementation state but is
       referenced by generated signatures. Promote only the managed metadata
       visibility so the referenced wrapper is emitted. -->
  <attr path="/api/package[@name='org.mozilla.geckoview']/class[@name='GeckoSession.Window']"
        name="visibility">public</attr>

  <!-- Java getter/setter names would otherwise synthesize C# properties whose
       names collide with GeckoSession's nested delegate interface types. Keep
       the callable methods and suppress only property synthesis. -->
  <attr path="/api/package[@name='org.mozilla.geckoview']/class[@name='GeckoSession']/method[@name='getHistoryDelegate' or @name='setHistoryDelegate' or @name='getNavigationDelegate' or @name='setNavigationDelegate' or @name='getPermissionDelegate' or @name='setPermissionDelegate' or @name='getSelectionActionDelegate' or @name='setSelectionActionDelegate']"
        name="propertyName"></attr>

  <!-- The identity-credential prompt constructor exposes a less-visible nested
       observer in Java. Match the containing public API visibility in managed
       metadata so C# accessibility remains consistent. -->
  <attr path="/api/package[@name='org.mozilla.geckoview']/interface[@name='GeckoSession.PromptDelegate.BasePrompt.Observer']"
        name="visibility">public</attr>

  <!-- These implementation/optional surfaces are not required by the BKE DNA
       GeckoView host and currently translate into invalid C# inheritance or
       generic signatures. Removing them from the managed API does not remove
       their Java bytecode from the GeckoView artifact. -->
  <remove-node path="/api/package[@name='org.webrtc']" />
  <remove-node path="/api/package[@name='org.mozilla.gecko.media']/class[@name='GeckoHlsAudioRenderer']" />
  <remove-node path="/api/package[@name='org.mozilla.gecko.media']/class[@name='GeckoHlsVideoRenderer']" />
  <remove-node path="/api/package[@name='org.mozilla.gecko.media']/class[@name='HttpChannelDataSource']" />
  <remove-node path="/api/package[@name='org.mozilla.geckoview']/class[@name='TranslationsController']" />
  <remove-node path="/api/package[@name='org.mozilla.geckoview']/class[@name='ContentBlocking.Settings.Builder']" />
  <remove-node path="/api/package[@name='org.mozilla.geckoview']/class[@name='GeckoRuntimeSettings.Builder']" />
</metadata>
